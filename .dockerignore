# Mirrors .gitignore semantics for the Docker build context. Without
# this file, `COPY . .` in Dockerfile would ingest local dev state,
# build artifacts, secrets, IDE files, and test fixtures — bloating
# the context, slowing builds, and risking leaks into the image.
#
# Keep this file in sync with .gitignore for any new ignore patterns
# that affect the build (additions to /local, etc.).

# dependencies — installed fresh inside the deps stage
node_modules
.yarn/cache
.yarn/install-state.gz
.pnp.*

# build output — re-built inside the builder stage
.next
.next-e2e
out
build
*.tsbuildinfo

# testing artifacts — not needed in production image
coverage
playwright-report
test-results
e2e/.auth
*.zip
**/*.test.ts
**/*.test.tsx
**/*.integration.test.ts
**/__tests__
**/__mocks__
**/__snapshots__

# secrets + local dev state — MUST never enter the image
.env
.env.*
.encryption-key
/local
*.db
*.db-journal
*.db-wal
*.db-shm

# IDE / editor / OS
.vscode
.idea
.DS_Store
*.swp
*.swo

# git + CI metadata — not runtime
.git
.github
.gitignore
.gitattributes
.dockerignore

# Claude Code runtime + planning docs — never relevant to a release image
.claude
HANDOFF.md
CLAUDE.md
AGENTS.md
plans
plan-*.md

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# misc — keep LICENSE in the image for compliance
*.pem
docker-compose*.yml
Dockerfile.*
