    "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js Server",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/.bin/next",
      "args": ["dev", "-p", "7272"],
      "cwd": "${workspaceFolder}",
      "restart": true,
      "runtimeArgs": ["--inspect"],
      "console": "integratedTerminal",
      "env": {
        "LOG_LEVEL": "debug"
      }
    }
  ]
}