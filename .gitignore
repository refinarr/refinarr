# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/e2e/.auth/
*.zip

# next.js
/.next/
/.next-e2e/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local dev artifacts (db files, encryption keys) — tracked folder, ignored contents
/local/*
!/local/.gitkeep
# legacy root-level encryption key (pre-local/ migration)
.encryption-key

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
*.db
*.db-journal
*.db-wal
*.db-shm
plan-v1.md

# Claude Code runtime state
.claude/*.lock
.claude/
HANDOFF.md
