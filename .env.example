# Logging level: debug | info | warn | error
# pino's threshold AND the threshold for what gets persisted to the AppLog table.
LOG_LEVEL=info

NODE_ENV=development

# Docker: UID/GID owning /data
PUID=1000
PGID=1000
TZ=UTC

# ---- Security ----

# Master key used to encrypt Instance.apiKey at rest with AES-256-GCM.
# Leave UNSET to auto-generate a key file at /data/.encryption-key (mode 0600)
# on first launch. If you set this, the file is NOT created.
# Format: 32 random bytes, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# WARNING: losing this key (or the auto-generated file) makes existing
# instance API keys unrecoverable — you'll need to re-add the instances.
# ENCRYPTION_KEY=

# Override on-disk key location (dev default: ./.encryption-key,
# prod default: /data/.encryption-key)
# ENCRYPTION_KEY_PATH=

# Reverse-proxy auth trust mode (Authelia / Authentik / Caddy auth / etc.)
# When true, remedarr trusts the upstream proxy's username header and skips
# its own login. Only enable this when remedarr is bound to a private
# interface that ONLY the trusted proxy can reach — anything else can spoof
# the header.
# Remedarr deliberately does NOT read X-Forwarded-For for auth.
# TRUST_PROXY_AUTH=false

# Header name to read the username from when TRUST_PROXY_AUTH=true.
# Default is X-Remote-User (Authelia/Authentik convention). Change to match
# your proxy's configured header.
# PROXY_USER_HEADER=X-Remote-User
