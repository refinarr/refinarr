# ---- Logging ----

# Logging level: debug | info | warn | error
# pino's threshold AND the threshold for what gets persisted to the AppLog
# table. Below this threshold, both pino and DB persistence skip — keeps the
# AppLog table from filling under noisy debug output.
LOG_LEVEL=info

# Max rows to keep in the AppLog table. Older entries are trimmed when the
# repository inserts past this cap.
# LOG_RETENTION_CAP=5000

# Max rows to keep in the ActionLog table (search/delete history). Same
# trim-on-insert pattern as LOG_RETENTION_CAP.
# ACTION_LOG_RETENTION_CAP=5000

# Max rows to keep in the SearchQueue table.
# SEARCH_QUEUE_RETENTION_CAP=5000

# ---- Runtime ----

NODE_ENV=development

# Docker: UID/GID owning /data
PUID=1000
PGID=1000
TZ=UTC

# Outbound rate-limit per Sonarr/Radarr instance, requests-per-second.
# Token-bucket with burst = 2× the steady-state rate. Default 50 keeps a
# 100+ series library rebuild responsive on typical hardware. Lower this if
# your *arr instances rate-limit refinarr or if your indexers ban on burst.
# ARR_RATE_LIMIT=50

# ---- Security ----

# Master key used to encrypt Instance.apiKey at rest with AES-256-GCM.
# Leave UNSET to auto-generate a key file at /data/.encryption-key (mode 0600)
# on first launch. If you set this, the file is NOT created.
# Format: 32 random bytes, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# WARNING: losing this key (or the auto-generated file) makes existing
# instance API keys unrecoverable — you'll need to re-add the instances.
# ENCRYPTION_KEY=

# Override on-disk key location (dev default: ./.encryption-key,
# prod default: /data/.encryption-key)
# ENCRYPTION_KEY_PATH=

# Reverse-proxy auth trust mode (Authelia / Authentik / Caddy auth / etc.)
# When true, refinarr trusts the upstream proxy's username header and skips
# its own login. Only enable this when refinarr is bound to a private
# interface that ONLY the trusted proxy can reach — anything else can spoof
# the header.
# Refinarr deliberately does NOT read X-Forwarded-For for auth.
# TRUST_PROXY_AUTH=false

# Header name to read the username from when TRUST_PROXY_AUTH=true.
# Default is X-Remote-User (Authelia/Authentik convention). Change to match
# your proxy's configured header.
# PROXY_USER_HEADER=X-Remote-User

# ---- Dev-only ----

# Hosts allowed to hit the Next.js dev server (HMR websocket, _next/* assets)
# from a non-localhost origin. Needed when testing on a phone or other LAN
# device — otherwise Next.js blocks the cross-origin request. Comma-separate
# for multiple hosts. Production ignores this entirely.
# NEXT_DEV_ALLOWED_ORIGINS=10.10.1.28,192.168.1.50

# Override the Next.js build output directory. Used by Playwright (.next-e2e)
# so the e2e dev server doesn't collide with the primary dev server's
# .next/ lock file.
# NEXT_DIST_DIR=.next
